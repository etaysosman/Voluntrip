<%- include('includes/starting-pages') %>
  <title>Register | VolunTrip</title>
</head>

<body class="vt page-register">
  <div class="vt-bg"></div>

  <main class="vt-wrap">
    <div class="container">
      <div class="vt-auth">

        <a href="/" class="vt-back">← Back</a>

        <section class="vt-card">
          <h1 class="vt-title">Sign up</h1>

          <% if (errorMessage) { %>
            <div class="alert alert-danger text-center" role="alert">
              <%= errorMessage %>
            </div>
          <% } %>
          
         <form action="/register" method="POST" class="signup-form vt-form" id="registerForm">

  <div class="row vt-row">
    <div class="col-12 col-sm-6">
      <label for="fullName" class="vt-label">Full Name</label>
      <input type="text" class="form-control vt-input" id="fullName" name="fullName" placeholder="First & Last name" required>
    </div>
    <div class="col-12 col-sm-6 mt-3 mt-sm-0">
      <label for="email" class="vt-label">Email</label>
      <input type="email" class="form-control vt-input" id="email" name="email" placeholder="Email address" required>
    </div>
  </div>

  <div class="row vt-row">
    <div class="col-12 col-sm-6">
      <label for="id" class="vt-label">ID Number</label>
      <input type="text" class="form-control vt-input" id="id" name="id" placeholder="9 digits, numbers only" required>
    </div>
   <div class="col-12 col-sm-6 mt-3 mt-sm-0">
      <label for="country" class="vt-label">Country</label>
      <input type="text" class="form-control vt-input" id="country" name="country" placeholder="Where do you live?" required>
    </div>
  </div>

  <div class="row vt-row">
    <div class="col-12 col-sm-6">
      <label for="birthdate" class="vt-label">Birthdate</label>
      <input type="date" class="form-control vt-input" id="birthdate" name="birthdate" title="Cannot be in the future" required>
    </div>
    <div class="col-12 col-sm-6 mt-3 mt-sm-0">
      <label for="gender" class="vt-label">Gender</label>
      <select class="form-control vt-input" id="gender" name="gender" required>
        <option value="" selected disabled>Select...</option>
        <option value="Man">Male</option>
        <option value="Woman">Female</option>
        <option value="Other">Other</option>
      </select>
    </div>
  </div>

  <div class="row vt-row mt-4">
    <div class="col-12 col-sm-6">
      <label for="username" class="vt-label">Username</label>
      <input type="text" class="form-control vt-input" id="username" name="username" placeholder="Min 4 chars, no spaces" required>
    </div>
    <div class="col-12 col-sm-6 mt-3 mt-sm-0">
      <label for="password" class="vt-label">Password</label>
      <input type="password" class="form-control vt-input" id="password" name="password" placeholder="8+ chars" required>
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-12 text-center">
      <button type="submit" class="btn vt-btn vt-btn--dark w-75">Voluntrip Now</button>
    </div>
  </div>

</form>

          <div class="vt-divider"></div>

          <div class="text-center">
            <p class="mb-2 text-muted">Having trouble?</p>
            <a href="https://alonnu.mtacloud.co.il/voluntrip-support/contact.html" class="btn vt-btn vt-btn--light px-5">Report An Issue</a>
          </div>

        </section>
      </div>
    </div>
  </main>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/validation.js"></script>
</body>
</html>