<%- include('includes/starting-pages') %>
<title>Register</title>
</head>

<body class="vt page-register">
<div class="vt-bg"></div>

  <main class="vt-wrap">
    <div class="container">
      <div class="vt-auth">

        <a href="/" class="vt-back">← Back</a>

        <section class="vt-card">
          <h1 class="vt-title">Sign up</h1>

          <% if (errorMessage) { %>
            <div class="alert alert-danger text-center" role="alert">
              <%= errorMessage %>
            </div>
          <% } %>
          <form action="/register" method="POST" class="signup-form vt-form" id="registerForm">

            <div class="form-group row align-items-center vt-row">
              <label for="fullName" class="col-12 col-sm-4 col-form-label vt-label">Full Name</label>
              <div class="col-12 col-sm-7">
                <input type="text" class="form-control vt-input" id="fullName" name="fullName" placeholder="First & Last name" required>
              </div>
            </div>

            <div class="form-group row align-items-center vt-row">
              <label for="id" class="col-12 col-sm-4 col-form-label vt-label">ID Number</label>
              <div class="col-12 col-sm-7">
                <input type="text" class="form-control vt-input" id="id" name="id" placeholder="9 digits, numbers only" required>
              </div>
            </div>

            <div class="form-group row align-items-center vt-row">
              <label for="birthdate" class="col-12 col-sm-4 col-form-label vt-label">Birthdate</label>
              <div class="col-12 col-sm-7">
                <input type="date" class="form-control vt-input" id="birthdate" name="birthdate" title="Cannot be in the future" required>
              </div>
            </div>

            <div class="form-group row align-items-center vt-row">
              <label for="email" class="col-12 col-sm-4 col-form-label vt-label">Email</label>
              <div class="col-12 col-sm-7">
                <input type="email" class="form-control vt-input" id="email" name="email" placeholder="Must contain '@' and '.'" required>
              </div>
            </div>

            <div class="form-group row align-items-center vt-row">
              <label for="username" class="col-12 col-sm-4 col-form-label vt-label">Username</label>
              <div class="col-12 col-sm-7">
                <input type="text" class="form-control vt-input" id="username" name="username" placeholder="Min 4 chars, no spaces" required>
              </div>
            </div>

            <div class="form-group row align-items-center vt-row">
              <label for="password" class="col-12 col-sm-4 col-form-label vt-label">Password</label>
              <div class="col-12 col-sm-7">
                <input type="password" class="form-control vt-input" id="password" name="password" placeholder="8+ chars, 1 letter, 1 number" required>
              </div>
            </div>

            <br>

            <div>
              <div class="col-sm-7 offset-sm-4">
                <button type="submit" class="btn vt-btn vt-btn--dark w-50">Voluntrip Now</button>
              </div>
            </div>

          </form>

          <div class="vt-divider"></div>

          <div class="text-center">
            <p class="mb-2 text-muted">Having trouble?</p>
            <a href="#" class="btn vt-btn vt-btn--light px-5">Report An Issue</a>
          </div>

        </section>
      </div>
    </div>
  </main>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/validation.js"></script>
</body>
</html>