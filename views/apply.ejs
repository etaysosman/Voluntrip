<%- include('includes/head') %>
  <link rel="stylesheet" href="/css/apply.css">
  <title>Apply for <%= activity.title %> | VolunTrip</title>
</head>

<body>

  <%- include('includes/menu') %>

  <main class="container py-5">
    <div class="ap-center">
      
      <div class="ap-header">
        <div class="text-center">
          <span class="ap-badge">Application Form</span>
          <h1 class="ap-title">Apply for <%= activity.title %></h1>
          <p class="ap-subtitle">
            <i class="bi bi-geo-alt-fill"></i> <%= activity.location %> &nbsp;|&nbsp; 
            <i class="bi bi-building"></i> <%= activity.organizer %>
          </p>
        </div>
      </div>

      <div class="ap-card mt-4">
        <form id="applyForm" action="/apply" method="POST" novalidate>
          
          <input type="hidden" name="activityId" value="<%= activity.activityId %>">
          <input type="hidden" name="userId" value="<%= userId %>"> <div class="row g-4">
            
            <div class="col-md-6">
              <label for="startDate" class="form-label ap-label">Preferred Start Date</label>
              <input type="date" class="form-control ap-input" id="startDate" name="startDate" required>
            </div>

            <div class="col-md-6">
              <label for="durationWeeks" class="form-label ap-label">Planned Duration</label>
              <select class="form-select ap-input" id="durationWeeks" name="durationWeeks" required>
                <option value="" selected disabled>Select duration...</option>
                <option value="1-2 weeks">1-2 Weeks</option>
                <option value="1 month">1 Month</option>
                <option value="2-3 months">2-3 Months</option>
                <option value="3+ months">More than 3 Months</option>
              </select>
            </div>

            <div class="col-md-6">
              <label for="additionalLanguage" class="form-label ap-label">Spoken Language</label>
              <select class="form-select ap-input" id="additionalLanguage" name="additionalLanguage" required>
                <option value="" selected disabled>Select language...</option>
                <option value="English">English</option>
                <option value="Spanish">Spanish</option>
                <option value="Hindi">Hindi</option>
                <option value="Arabic">Arabic</option>
                <option value="German">German</option>
                <option value="Russian">Russian</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label ap-label d-block">Willing to do physical work?</label>
              <div class="d-flex gap-4 mt-2 px-2">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="physicalWork" id="physicalYes" value="Yes" required>
                  <label class="form-check-label" for="physicalYes">Yes</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="physicalWork" id="physicalNo" value="No">
                  <label class="form-check-label" for="physicalNo">No</label>
                </div>
              </div>
            </div>

            <div class="col-12">
              <label for="experience" class="form-label ap-label">Previous Experience & Motivation</label>
              <textarea class="form-control ap-input" id="experience" name="experience" rows="5" placeholder="Tell us why you want to join..." required></textarea>
            </div>

            <div class="col-12">
              <div class="p-3 border rounded bg-light"> 
                <div class="form-check mb-0"> 
                  <input class="form-check-input" type="checkbox" id="agreeToTerms" name="agreeToTerms" required>
                  <label class="form-check-label small text-muted" for="agreeToTerms">
                    Agree to Terms & Conditions and consent to share my details with <strong><%= activity.organizer %></strong>.
                  </label>
                </div>
              </div>
            </div>

            <div class="col-12 mt-4 d-flex justify-content-between align-items-center">
              <a href="/explore" class="text-decoration-none text-muted fw-bold">
                <i class="bi bi-arrow-left"></i> Cancel
              </a>
              <button type="submit" class="btn btn-primary ap-btn-submit px-4 py-2">Submit Application</button>
            </div>

          </div>
        </form>
      </div>

    </div>
  </main>

  <script src="/js/validation.js"></script>

  <%- include('includes/end') %>